-- ESP
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local ESPEnabled = false
local ESPConnections = {}


local function removeAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local char = player.Character

            local box = char:FindFirstChild("ESP_Box")
            if box then
                box:Destroy()
            end

            local head = char:FindFirstChild("Head")
            if head then
                local name = head:FindFirstChild("ESP_Name")
                if name then
                    name:Destroy()
                end
            end
        end
    end

    for _, conn in ipairs(ESPConnections) do
        conn:Disconnect()
    end

    table.clear(ESPConnections)
end


local function createESP(player)
    if player == LocalPlayer then
        return
    end

    local function updateESP()
        if not ESPEnabled then
            return
        end

        local char = player.Character
        if not char then
            return
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")

        if not hrp or not head then
            return
        end

        -- Xóa ESP cũ
        local oldBox = char:FindFirstChild("ESP_Box")
        if oldBox then
            oldBox:Destroy()
        end

        local oldName = head:FindFirstChild("ESP_Name")
        if oldName then
            oldName:Destroy()
        end

        -- Box ESP
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Box"
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
        highlight.Parent = char

        -- Name ESP
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Name"
        billboard.Adornee = head
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(5, 0, 1, 0)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.Parent = head

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 0, 0)
        label.TextStrokeTransparency = 0.5
        label.Text = player.Name
        label.Font = Enum.Font.SourceSansBold
        label.TextScaled = true
        label.Parent = billboard

        -- Cập nhật kích thước tên theo khoảng cách
        local conn

        conn = RunService.RenderStepped:Connect(function()
            if not ESPEnabled then
                conn:Disconnect()
                return
            end

            local currentChar = player.Character
            local currentHead = currentChar and currentChar:FindFirstChild("Head")
            local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")

            if not currentHead or not currentHrp or not billboard.Parent then
                return
            end

            local camera = workspace.CurrentCamera
            local dist = (camera.CFrame.Position - currentHrp.Position).Magnitude

            billboard.Size = UDim2.new(
                math.clamp(10 / dist, 1, 5),
                0,
                math.clamp(2 / dist, 0.5, 2),
                0
            )
        end)

        table.insert(ESPConnections, conn)
    end

    -- ESP lại khi player respawn
    local conn = player.CharacterAdded:Connect(function()
        if ESPEnabled then
            task.wait(1)
            updateESP()
        end
    end)

    table.insert(ESPConnections, conn)

    if player.Character then
        updateESP()
    end
end


local function enableESP()
    ESPEnabled = true

    for _, player in ipairs(Players:GetPlayers()) do
        createESP(player)
    end
end


local function disableESP()
    ESPEnabled = false
    removeAllESP()
end


-- Toggle ESP trong Visual
VisualTab:CreateToggle({
    Name = "ESP",
    CurrentValue = false,

    Callback = function(Value)
        if Value then
            enableESP()
        else
            disableESP()
        end
    end,
})

ESPTab:CreateToggle({
    Name = "espplayer",
    CurrentValue = false,
    Callback = function(Value)
        ESPEnabled = Value
        if Value then
            for _, p in pairs(game:GetService("Players"):GetPlayers()) do
                createESP(p)
            end
            local conn = game:GetService("Players").PlayerAdded:Connect(function(p)
                createESP(p)
            end)
            table.insert(ESPConnections, conn)
        else
            removeAllESP()
        end
    end,
})

local MainTab = Window:CreateTab("Fly")

-- Vars
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local flying = false
local speeds = 1              -- số luồng translate / cũng là cơ bản cho tốc độ
local speedValue = 1          -- tốc độ dùng cho BV
local tpwalking = false
local nowe = false

local ascendToggle = false    -- toggle UI
local descendToggle = false
local ascendHold = false      -- giữ phím (E)
local descendHold = false     -- giữ phím (Q)

local flyBG, flyBV, flyRenderConn

-- Helper: trạng thái ascend thực sự
local function isAscending()
	return ascendToggle or ascendHold
end
local function isDescending()
	return descendToggle or descendHold
end

-- Start/Stop translate threads (giữ nguyên logic gốc)
local function startTranslateThreads()
	tpwalking = true
	for i = 1, speeds do
		task.spawn(function()
			local hb = RunService.Heartbeat
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildWhichIsA("Humanoid")
			while tpwalking and hb:Wait() and char and hum and hum.Parent do
				if hum.MoveDirection.Magnitude > 0 then
					-- dịch chuyển dựa trên MoveDirection (hài hòa với camera)
					char:TranslateBy(hum.MoveDirection)
				end
			end
		end)
	end
end

local function stopTranslateThreads()
	tpwalking = false
end

--Fly
local function enableFly()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	nowe = true
	-- start translate threads
	startTranslateThreads()

	-- disable animate + freeze play speed
	if char:FindFirstChild("Animate") then
		char.Animate.Disabled = true
	end
	local Hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("AnimationController")
	if Hum then
		for _, v in next, Hum:GetPlayingAnimationTracks() do
			v:AdjustSpeed(0)
		end
	end

	-- disable 
	local disableStates = {
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Flying,
		Enum.HumanoidStateType.Freefall,
		Enum.HumanoidStateType.GettingUp,
		Enum.HumanoidStateType.Jumping,
		Enum.HumanoidStateType.Landed,
		Enum.HumanoidStateType.Physics,
		Enum.HumanoidStateType.PlatformStanding,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Running,
		Enum.HumanoidStateType.RunningNoPhysics,
		Enum.HumanoidStateType.Seated,
		Enum.HumanoidStateType.StrafingNoPhysics,
		Enum.HumanoidStateType.Swimming
	}
	for _, st in ipairs(disableStates) do
		pcall(function() hum:SetStateEnabled(st, false) end)
	end
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Swimming) end)

	local jointPart
	if hum.RigType == Enum.HumanoidRigType.R6 then
		jointPart = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
	else
		jointPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
	end
	if not jointPart then jointPart = char:FindFirstChildWhichIsA("BasePart") end

	flyBG = Instance.new("BodyGyro")
	flyBG.P = 9e4
	flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	flyBG.CFrame = jointPart.CFrame
	flyBG.Parent = jointPart

	flyBV = Instance.new("BodyVelocity")
	flyBV.Velocity = Vector3.new(0, 0.1, 0)
	flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	flyBV.Parent = jointPart

	--
	flyRenderConn = RunService.RenderStepped:Connect(function()
		if not nowe then return end
		local cam = workspace.CurrentCamera
		local moveDir = hum.MoveDirection or Vector3.new(0,0,0)
		local mov = Vector3.new(0,0,0)
		if moveDir.Magnitude > 0 then
			--  camera: forward/back + right/left
			mov = (cam.CFrame.LookVector * moveDir.Z + cam.CFrame.RightVector * moveDir.X) * speedValue
		end

		-- vertical velocity to toggle
		local vert = 0
		if isAscending() then vert = speedValue end
		if isDescending() then vert = -speedValue end

		-- set velocity
		if flyBV and flyBV.Parent then
			flyBV.Velocity = mov + Vector3.new(0, vert, 0)
		end

		--  orientation 
		if flyBG and flyBG.Parent then
			flyBG.CFrame = cam.CFrame * CFrame.Angles(-math.rad((moveDir.Z) * 50 * (speedValue/50)), 0, 0)
		end
	end)
end

-- off fly
local function disableFly()
	nowe = false
	stopTranslateThreads()

	-- disconnect render + destroy BV/BG
	if flyRenderConn then
		flyRenderConn:Disconnect()
		flyRenderConn = nil
	end
	if flyBG then
		pcall(function() flyBG:Destroy() end)
		flyBG = nil
	end
	if flyBV then
		pcall(function() flyBV:Destroy() end)
		flyBV = nil
	end

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		for _, st in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
			pcall(function() hum:SetStateEnabled(st, true) end)
		end
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics) end)
	end

	-- enable animate
	if char and char:FindFirstChild("Animate") then
		char.Animate.Disabled = false
	end
end

-- UI: Toggle Fly
MainTab:CreateToggle({
	Name = "Fly",
	CurrentValue = false,
	Flag = "FlyToggle",
	Callback = function(Value)
		flying = Value
		if Value then
			enableFly()
		else
			disableFly()
		end
	end,
})

-- UI: Slider tốc độ
MainTab:CreateSlider({
	Name = "Speed  *note:When adjusting the speed, restart the flight to avoid errors.  ",
	Range = {1, 20},
	Increment = 1,
	CurrentValue = speedValue,
	Flag = "FlySpeed",
	Callback = function(Value)
		speedValue = Value
		speeds = math.max(1, math.floor(Value)) -- giữ gần giống GUI gốc: số luồng = speeds
		if nowe then
			stopTranslateThreads()
			startTranslateThreads()
		end
	end,
})

