local R=game:GetService("RunService")
local P=game.Players.LocalPlayer
getgenv().NC=not getgenv().NC
if getgenv().NCC then getgenv().NCC:Disconnect() end
if getgenv().NC then
    getgenv().NCC=R.Stepped:Connect(function()
        local c=P.Character
        if c then for _,v in c:GetDescendants() do
            if v:IsA("BasePart") then v.CanCollide=false end
        end end
    end)
else
    local c=P.Character
    if c then for _,v in c:GetDescendants() do
        if v:IsA("BasePart") then v.CanCollide=true end
    end end
end
