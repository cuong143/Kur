local function CreateHighlight(target, color, text)
    if not target or not target.Parent then return end
    if espCache[target] then
        espCache[target][2].TextLabel.Text = text
        return
    end
    local hl = Instance.new("Highlight", target)
    hl.FillColor = color
    hl.FillTransparency = 0.6
    hl.OutlineColor = color
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local bb = Instance.new("BillboardGui", target)
    bb.Size = UDim2.new(0, 150, 0, 30)
    bb.AlwaysOnTop = true
    bb.Adornee = target:FindFirstChildWhichIsA("BasePart") or target

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.GothamBold
    lbl.TextStrokeTransparency = 0

    espCache[target] = {hl, bb}
end

local function DrawTracer(target, color)
    if not target or not target.Parent or tracerCache[target] then return end
    local line = Drawing.new("Line")
    line.Color = color
    line.Thickness = 1.5
    line.Transparency = 0.7
    line.Visible = false
    tracerCache[target] = line
end

local function ClearVisuals()
    for _, v in pairs(espCache) do
        pcall(function()
            v[1]:Destroy()
            v[2]:Destroy()
        end)
    end
    for _, line in pairs(tracerCache) do
        pcall(function() line:Remove() end)
    end
    table.clear(espCache)
    table.clear(tracerCache)
end

-- ================= HITBOX SİSTEMİ (DÜZELTİLMİŞ) =================
-- Gerçek Head parçasına dokunmaz -> canavarlar donmaz.
local function ApplyHitbox(obj)
    if obj == nil then return end
    local head = obj:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end

    local existing = hitboxCache[obj]
    if existing and existing.Parent then
        -- Sadece boyutu güncelle
        existing.Size = Vector3.new(
            Config.Combat.HitboxSize,
            Config.Combat.HitboxSize,
            Config.Combat.HitboxSize
        )
        return
    end

    -- Ayrı hitbox parçası oluştur (gerçek Head'e dokunma!)
    local hb = Instance.new("Part")
    hb.Name = "HitboxExpand"
    hb.Size = Vector3.new(
        Config.Combat.HitboxSize,
        Config.Combat.HitboxSize,
        Config.Combat.HitboxSize
    )
    hb.Transparency = 0.5
    hb.CanCollide = false
    hb.CanQuery = true
    hb.Massless = true
    hb.Anchored = false
    hb.CFrame = head.CFrame
    hb.Color = Color3.fromRGB(255, 80, 80)
    hb.Parent = obj

    -- Head'e kaynakla -> hareketi bozmaz, Head'i takip eder
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head
    weld.Part1 = hb
    weld.Parent = hb

    hitboxCache[obj] = hb
end

local function ClearHitboxes()
    for obj, hb in pairs(hitboxCache) do
        pcall(function() hb:Destroy() end)
    end
    table.clear(hitboxCache)
end

