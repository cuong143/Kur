-- ================= GELİŞMİŞ CANAVAR ALGILAMA =================
local MonsterKeywords = {
    "monster", "enemy", "killer", "zombie", "bot", "nextbot", "boss", "guard",
    "entity", "slender", "scp", "rush", "ambush", "figure", "seek", "screech",
    "halt", "eyes", "glitch", "timothy", "jack", "hide", "piggy", "granny",
    "smiler", "partygoer", "bacteria", "hunter", "imposter"
}

local function IsRealEntity(obj)
    if not obj or not obj:IsA("Model") or obj == GetCharacter() then return false end
    local isPlayer = Players:GetPlayerFromCharacter(obj)
    if isPlayer then
        if isPlayer == LocalPlayer then return false end
        if isPlayer.Team then
            local tName = isPlayer.Team.Name:lower()
            if tName:find("killer") or tName:find("monster") or tName:find("beast") or tName:find("infected") or tName:find("piggy") then
                return true
            end
        end
        if obj:HasTag("Monster") or obj:HasTag("Killer") then return true end
        return false
    end

    local name = obj.Name:lower()
    if name:find("shop") or name:find("statue") or name:find("display") or name:find("dummy") or name:find("pet") then
        return false
    end

    if obj:HasTag("Entity") or obj:HasTag("Monster") or obj:HasTag("Enemy") or obj:HasTag("Killer") then
        return true
    end

    for _, keyword in ipairs(MonsterKeywords) do
        if name:find(keyword) then return true end
    end

    local hum = obj:FindFirstChildOfClass("Humanoid")
    local root = obj:FindFirstChild("HumanoidRootPart")
    if hum and root then return true end

    if obj:FindFirstChild("Hitbox") or (obj:FindFirstChild("Head") and not hum) then
        return true
    end

    return false
end

