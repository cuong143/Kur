        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Config.Movement.ClickTP and input.UserInputType == Enum.UserInputType.MouseButton1 and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        local root = GetRootPart()
        if root and Mouse.Hit then
            root.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))
        end
    end
end)

local OriginalLighting = {
    Ambient = Lighting.Ambient,
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime
}

RunService.RenderStepped:Connect(function()
    local hum = GetHumanoid()
    if hum then
        hum.WalkSpeed = Config.Movement.WalkSpeed
        hum.JumpPower = Config.Movement.JumpPower
        if Config.Utility.GodMode then
            hum.Health = hum.MaxHealth
        end
        if Config.Movement.NoRagdoll then
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        else
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        end
    end

    if Config.Utility.ZoomBypass then
        LocalPlayer.CameraMaxZoomDistance = 100000
    else
        LocalPlayer.CameraMaxZoomDistance = 400
    end

    if Config.Visuals.Fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
    else
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.ClockTime = OriginalLighting.ClockTime
    end

    if Config.Visuals.Tracers then
        for target, line in pairs(tracerCache) do
            if target and target.Parent and target:FindFirstChildWhichIsA("BasePart") then
                local vector, onScreen = Camera:WorldToViewportPoint(target:FindFirstChildWhichIsA("BasePart").Position)
                if onScreen then
                    line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    line.To = Vector2.new(vector.X, vector.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    end

    if Config.Combat.Aimlock then
        local nearest = nil
        local shortest = Config.Combat.AimDistance
        local myRoot = GetRootPart()
        if myRoot then
            for _, obj in ipairs(Cache.Entities) do
                if obj == nil then continue end
                local tPart = obj:FindFirstChild(Config.Combat.AimPart) or obj:FindFirstChildWhichIsA("BasePart")
                if tPart then
                    local dist = (tPart.Position - myRoot.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = tPart
                    end
                end
            end
            if nearest then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, nearest.Position)
            end
        end
    end

    -- DÜZELTİLMİŞ HITBOX: Gerçek Head'e dokunmaz, canavarlar donmaz
    if Config.Combat.HeadHitbox then
        for _, obj in ipairs(Cache.Entities) do
            if obj == nil then continue end
            ApplyHitbox(obj)
        end
    else
        ClearHitboxes()
    end
end)

task.spawn(function()
    while task.wait(0.5) do
        if not Config.Visuals.Tracers then
            for _, line in pairs(tracerCache) do
                line.Visible = false
            end
        end

        if Config.Utility.AutoInteract then
            local myRoot = GetRootPart()
            if myRoot then
                for _, prompt in ipairs(Cache.Prompts) do
                    if prompt and prompt.Parent and prompt.Enabled then
                        local pPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                        if pPart and (pPart.Position - myRoot.Position).Magnitude <= prompt.MaxActivationDistance then
                            pcall(function() fireproximityprompt(prompt) end)
                        end
                    end
                end
            end
        end

        if Config.Visuals.PlayerESP or Config.Visuals.Tracers then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    if Config.Visuals.PlayerESP then
                        CreateHighlight(p.Character, Color3.fromRGB(100, 200, 255), p.Name)
                    end
                    if Config.Visuals.Tracers then
                        DrawTracer(p.Character, Color3.fromRGB(100, 200, 255))
                    end
                end
            end
        end

        if Config.Visuals.EntityESP or Config.Visuals.Tracers then
            for _, obj in ipairs(Cache.Entities) do
                if obj == nil then continue end
                if Config.Visuals.EntityESP then
                    CreateHighlight(obj, Color3.fromRGB(255, 50, 50), "[Monster] " .. obj.Name)
                end
                if Config.Visuals.Tracers then
                    DrawTracer(obj, Color3.fromRGB(255, 50, 50))
                end
            end
        end

        if Config.Visuals.ExitESP then
            for _, obj in ipairs(Cache.Exits) do
                if obj then
                    CreateHighlight(obj, Color3.fromRGB(50, 255, 50), "[Exit/Door]")
                end
            end
        end

        if Config.Visuals.ButtonESP then
            for _, obj in ipairs(Cache.Buttons) do
                if obj then
                    CreateHighlight(obj, Color3.fromRGB(255, 255, 50), "[Button/Lever]")
                end
            end
        end

        if Config.Visuals.ItemESP then
            for _, obj in ipairs(Cache.Items) do
                if obj then
                    CreateHighlight(obj, Color3.fromRGB(255, 150, 50), "[Item]")
                end
            end
        end
    end
end)
