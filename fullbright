local L=game:GetService("Lighting")
local R=game:GetService("RunService")

getgenv().FB=not getgenv().FB
if getgenv().FBC then getgenv().FBC:Disconnect() end

if getgenv().FB then
    local function F()
        L.Brightness=2
        L.ClockTime=14
        L.FogEnd=100000
        L.GlobalShadows=false
        L.OutdoorAmbient=Color3.fromRGB(128,128,128)
    end
    F()
    getgenv().FBC=R.RenderStepped:Connect(F)
end
